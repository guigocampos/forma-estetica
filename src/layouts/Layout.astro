---
import '@fontsource/archivo/latin-600.css';
import '@fontsource/archivo/latin-700.css';
import '@fontsource/archivo/latin-800.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '../styles/global.css';
const { title = 'Forma — Estética automotiva | Demonstração Ghati', description = 'Conheça a Forma, uma marca conceitual de estética automotiva em Praia Grande. Lavagem técnica, higienização e polimento em uma demonstração criada pela Ghati.' } = Astro.props;
const home = Astro.url.pathname === '/';
const quoteHref = home || Astro.url.pathname.startsWith('/servicos/') ? '#orcamento' : '/#orcamento';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title><meta name="description" content={description} /><meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0b0d10" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="pt_BR" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class:list={{ 'home-page': home }}>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Forma — página inicial">FORMA<span aria-hidden="true">/</span><small>ESTÉTICA AUTOMOTIVA</small></a>
      <button class="menu-toggle" aria-controls="navigation" aria-expanded="false" type="button">Menu <span aria-hidden="true">+</span></button>
      <nav id="navigation" aria-label="Principal"><a href="/" aria-current={home ? 'page' : undefined}>Início</a><a href={home ? '#servicos' : '/#servicos'}>Serviços</a><a href={home ? '#detalhes' : '/#detalhes'}>O cuidado</a><a class="nav-quote" href={quoteHref}>Solicitar orçamento <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="conteudo" tabindex="-1"><slot /></main>
    <footer class="site-footer section-shell"><div><a class="wordmark" href="/" aria-label="Forma — página inicial">FORMA<span aria-hidden="true">/</span><small>ESTÉTICA AUTOMOTIVA</small></a><p>Um conceito pensado<br /> para Praia Grande, SP.</p></div><div class="footer-links"><strong>Serviços</strong><a href="/servicos/lavagem-tecnica/">Lavagem técnica</a><a href="/servicos/higienizacao-interna/">Higienização interna</a><a href="/servicos/polimento/">Polimento</a></div><div class="footer-credit"><strong>Projeto demonstrativo / Ghati</strong><p>Marca fictícia. Imagens e filme conceituais produzidos com IA. Não representa um estabelecimento em funcionamento.</p><a href={quoteHref}>Quer esse site para sua empresa? ↗</a></div><div class="footer-bottom"><span>Forma / Estética automotiva</span><span>Design e desenvolvimento / Ghati</span></div></footer>
    <script src="../scripts/site.js"></script>
  </body>
</html>
