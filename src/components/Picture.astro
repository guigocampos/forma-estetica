---
const { name, alt, class: className = '', eager = false, sizes = '(max-width: 700px) 100vw, 60vw' } = Astro.props;
---
<img class={className} src={`/media/${name}-1200.webp`} srcset={`/media/${name}-640.webp 640w, /media/${name}-1200.webp 1200w, /media/${name}-1800.webp 1800w`} sizes={sizes} width="1800" height={name === 'garage' ? 1013 : 1200} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />

